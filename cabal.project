packages: .

-- The "base32" package has a stale bound on "base"
-- The "serialiase" and "cborg" dependencies of "tls" have
-- stale bounds on "base", "containers" and "time".
allow-newer:
    base32:base, cborg:base, serialise:base, serialise:containers, cborg:containers, serialise:time

constraints:
  base installed,
  array installed,
  binary installed,
  bytestring installed,
  containers installed,
  deepseq installed,
  directory installed,
  exceptions installed,
  file-io installed,
  filepath installed,
  ghc installed,
  ghc-bignum installed,
  ghc-boot installed,
  ghc-boot-th installed,
  ghc-prim installed,
  integer-gmp installed,
  mtl installed,
  os-string installed,
  rts installed,
  stm installed,
  template-haskell installed,
  text installed,
  time installed,
  transformers installed,
  unix installed
